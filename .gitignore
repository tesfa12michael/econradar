# ─────────────────────────────────────────────────────────────
# EconRadar — root .gitignore
# ─────────────────────────────────────────────────────────────

# Secrets / environment
.env
.env.*
!.env.example
*.pem
*.key

# Modal credentials. `modal token set` writes ~/.modal.toml, and the VPS runs the app as
# a system user whose home may be /opt/econradar — i.e. this working tree. Ignored here so
# an auth flow on the box can never stage a token into a public repo. Prefer the
# MODAL_TOKEN_ID / MODAL_TOKEN_SECRET env vars, which take precedence over this file.
.modal.toml
modal.toml

# ── Python (backend) ──
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

# ── Node / Next.js (frontend) ──
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
.vercel/
coverage/

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Local scratch ──
/tmp/
scratch/

# Caches written *inside* the working tree on the VPS, where $HOME is /opt/econradar:
# pip, matplotlib's fontlist, and the fastembed/HuggingFace model download (192 MB total).
# Untracked but not ignored meant one `git add -A` on the box would have committed them.
.cache/

# ── Claude Code local tooling (generic skill libraries, not project source) ──
.claude/

# ── Internal working docs (kept local; the polished public repo is built later) ──
/CLAUDE.md
/PROGRESS.md
/DEPLOYMENT.md
/DEMO_SCRIPT.md
/docs/
