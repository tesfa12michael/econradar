# ─────────────────────────────────────────────────────────────
# EconRadar — environment template (names only, no real values)
# Copy to `.env` (backend) and `frontend/.env.local` (frontend).
# NEVER commit a filled-in .env. See docs/architecture.md.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
SUPABASE_URL=                     # Required
SUPABASE_ANON_KEY=                # Required
SUPABASE_SERVICE_ROLE_KEY=        # Required (backend only — never ship to the client)
DATABASE_URL=                     # Required — direct Postgres connection string for SQLAlchemy
                                  #   e.g. postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres

# ── Data Source API Keys ──
FRED_API_KEY=                     # Required (free registration) — used from Phase 2
WORLD_BANK_API_KEY=               # Optional (REST is keyless; key only raises rate limits)
BIS_API_KEY=                      # Optional (public API is keyless)

# ── LLM Providers (used from Phase 3) ──
MISTRAL_API_KEY=                  # Required
GROQ_API_KEY=                     # Required
OPENROUTER_API_KEY=               # Required
GOOGLE_AI_STUDIO_API_KEY=         # Required

# ── Paid Escape Hatch (Optional — only if free tiers exhaust) ──
GOOGLE_VERTEX_AI_PROJECT_ID=      # Optional
GOOGLE_VERTEX_AI_LOCATION=        # Optional

# ── Application Config ──
NEXT_PUBLIC_API_URL=              # Required — public URL of the FastAPI backend (Render)
NEXT_PUBLIC_MAPTILER_KEY=         # Optional (MapLibre runs keyless with OSM tiles)
ENVIRONMENT=development           # Required — development | staging | production
LOG_LEVEL=INFO                    # Optional — default INFO

# ── Forecasting Config (used from Phase 3) ──
CHRONOS2_MODEL_SIZE=mini          # Optional — mini | small | base (default mini)
FORECAST_CACHE_TTL_DAYS=30        # Optional
NARRATION_CACHE_TTL_HOURS=24      # Optional
VLM_CACHE_TTL_DAYS=7              # Optional

# ── Admin Access ──
ADMIN_HEALTH_TOKEN_HASH=          # Required — SHA-256 HASH of the token, never the raw token
