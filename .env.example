# ─────────────────────────────────────────────────────────────
# EconRadar — environment template (names only, no real values)
# Copy to `.env` (backend) and `frontend/.env.local` (frontend).
# NEVER commit a filled-in .env. See docs/architecture.md.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
SUPABASE_URL=                     # Required
SUPABASE_ANON_KEY=                # Required
SUPABASE_SERVICE_ROLE_KEY=        # Required (backend only — never ship to the client)
DATABASE_URL=                     # Required — direct Postgres connection string for SQLAlchemy
                                  #   e.g. postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres

# ── Data Source API Keys ──
FRED_API_KEY=                     # Required (free registration) — used from Phase 2
WORLD_BANK_API_KEY=               # Optional (REST is keyless; key only raises rate limits)
BIS_API_KEY=                      # Optional (public API is keyless)

# ── LLM Providers (used from Phase 3) ──
# The rotation is Mistral -> Groq -> OpenRouter (decision #7); narration enters at
# Mistral, RAG Q&A at Groq (decision #24). Any subset works — an unconfigured
# provider is skipped, not retried. With none configured the AI endpoints return a
# truthful 404 rather than unverified text.
MISTRAL_API_KEY=                  # Required for narration's primary
GROQ_API_KEY=                     # Required for the RAG speed layer
OPENROUTER_API_KEY=               # Required — final fallback, and serves Qwen3-VL
GOOGLE_AI_STUDIO_API_KEY=         # Required for Gemini Flash (VLM primary)

# Model ids per provider. Free-tier model names change, so they are configuration.
MISTRAL_MODEL=mistral-small-latest        # Optional
GROQ_MODEL=llama-3.3-70b-versatile        # Optional
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free   # Optional
GEMINI_MODEL=gemini-2.5-flash             # Optional
OPENROUTER_VLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct:free # Optional
LLM_ENABLED=true                  # Optional — false disables every LLM/VLM call
LLM_TIMEOUT_SECONDS=45            # Optional
LLM_MAX_TOKENS=700                # Optional
LLM_TEMPERATURE=0.2               # Optional

# ── Modal (inference host — decision #21) ──
# MODAL_TOKEN_ID and MODAL_TOKEN_SECRET are deliberately NOT read from this file.
# pydantic-settings loads .env into the Settings object without populating
# os.environ, which is the only place the `modal` library looks — so on the VPS they
# live in /etc/econradar/modal.env, outside the git tree, and are put into the
# process environment by the systemd drop-in econradar.service.d/10-modal.conf.
MODAL_ENABLED=true                # Optional — false skips Modal and uses StatsForecast
MODAL_APP_NAME=econradar-forecast # Optional
MODAL_TIMEOUT_SECONDS=420         # Optional — a cold serverless GPU can take a while

# ── Paid Escape Hatch (Optional — only if free tiers exhaust) ──
GOOGLE_VERTEX_AI_PROJECT_ID=      # Optional
GOOGLE_VERTEX_AI_LOCATION=        # Optional

# ── Application Config ──
NEXT_PUBLIC_API_URL=              # Required — public URL of the FastAPI backend
                                  #   Set this in the Vercel dashboard for Production; it is
                                  #   read at build time and only ever used server-side.
ENVIRONMENT=development           # Required — development | staging | production
LOG_LEVEL=INFO                    # Optional — default INFO

# ── Forecasting Config (used from Phase 3) ──
# CHRONOS2_MODEL_SIZE is gone: Chronos-2 ships as a single 120M model, so there is
# no mini/small/base to choose between. The model id lives in the Modal app.
# Horizons are in PERIODS of the series' own frequency, not months — a literal
# 12 months would be one step for an annual series (see features.md 1.4).
FORECAST_HORIZON_MONTHLY=12       # Optional
FORECAST_HORIZON_QUARTERLY=8      # Optional
FORECAST_HORIZON_ANNUAL=5         # Optional
FORECAST_MIN_OBSERVATIONS=16      # Optional — shorter series are refused, not guessed at
FORECAST_CACHE_TTL_DAYS=30        # Optional
NARRATION_CACHE_TTL_HOURS=24      # Optional
VLM_CACHE_TTL_DAYS=7              # Optional
RAG_CACHE_TTL_HOURS=24            # Optional

# ── Groundedness + RAG (decision #8) ──
GROUNDEDNESS_MIN_SCORE=1.0        # Optional — below this a response is discarded, not served
GROUNDEDNESS_TOLERANCE=0.005      # Optional — rounding slack when matching a narrated figure
RAG_TOP_K=8                       # Optional
RAG_MIN_SIMILARITY=0.25           # Optional — below this, retrieval is treated as empty and
                                  #   the chat refuses rather than answering from memory
RAG_CONTEXT_TURNS=4               # Optional
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # Optional — must be 384-dim

# ── Admin Access ──
ADMIN_HEALTH_TOKEN_HASH=          # Optional until the admin endpoint exists (not built as of
                                  #   Phase 2 — /admin/health returns 404). When it lands, store
                                  #   the SHA-256 HASH of the token here, never the raw token.
